{
  "name": "@yuiseki/cosensecli",
  "version": "0.1.0",
  "description": "A read-only MCP server for Cosense, wrapping the cosense CLI",
  "homepage": "https://github.com/yuiseki/cosensecli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuiseki/cosensecli.git"
  },
  "bugs": {
    "url": "https://github.com/yuiseki/cosensecli/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "cosensecli": "bin/cosensecli.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cosense",
    "scrapbox",
    "mcp",
    "cli"
  ],
  "author": "yuiseki",
  "license": "MIT",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "type": "commonjs",
  "dependencies": {
    "@helpfeel/cosense-cli": "^1.17.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
